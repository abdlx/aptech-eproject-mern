PORT=5000
MONGO_URI=mongodb://localhost:27017/fitness-tracker
MONGO_DB_NAME=fitness-tracker
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Access token lifetime (any ms/zeit string). Sessions extend via refresh tokens.
ACCESS_TOKEN_TTL=1d
# Refresh token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# When 'false', email verification and password-reset tokens are NOT returned in
# API responses (production). Leave unset/true in dev to test without email.
EXPOSE_TOKENS=true

# Set 'true' to disable the reminder cron scheduler (e.g. in tests).
DISABLE_SCHEDULER=false
# Set 'true' to log stubbed email/push deliveries and scheduler activity.
LOG_DELIVERY=false

# Auth rate limiting: requests allowed per 15-min window per IP (default 10).
AUTH_RATE_LIMIT=10
# Set 'true' to disable all rate limiting (tests / local load work).
DISABLE_RATE_LIMIT=false
